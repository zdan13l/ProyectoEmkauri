<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- ARCHIVO FXML PARA LA PANTALLA DE PRODUCTOS OFRECIDOS POR EL EMPRENDEDOR -->
<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="controladores.ProductoEController" stylesheets="@../css/interfaz.css" styleClass="fondo-celeste">
    <children>
        <VBox alignment="TOP_CENTER" spacing="20"
                AnchorPane.topAnchor="30"
                AnchorPane.bottomAnchor="30"
                AnchorPane.leftAnchor="40"
                AnchorPane.rightAnchor="40">

            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="content-card">
                <Label text="📦 Mis Productos" styleClass="title-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnVolver" onAction="#handleVolver" text="Volver" styleClass="btn-secondary"/>
            </HBox>

            <VBox spacing="16" styleClass="content-card">

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Cursos y servicios publicados" styleClass="section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnAdministrar" onAction="#handleAdministrar" text="Administrar Producto" styleClass="green-button"/>
                </HBox>

                <TableView fx:id="tablaProductos" prefHeight="420" prefWidth="820" styleClass="styled-table">
                    <columns>
                        <TableColumn fx:id="colTitulo" prefWidth="200" text="Título"/>
                        <TableColumn fx:id="colTipo" prefWidth="120" text="Tipo"/>
                        <TableColumn fx:id="colCategoria" prefWidth="160" text="Categoría"/>
                        <TableColumn fx:id="colPrecio" prefWidth="140" text="Precio"/>
                        <TableColumn fx:id="colEstado" prefWidth="140" text="Estado"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </children>
</AnchorPane>
