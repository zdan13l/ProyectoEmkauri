<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="600" prefWidth="900" style="-fx-background-color: linear-gradient(to bottom right, #4A90E2, #50C9CE);" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controladores.ReclutadorController">

    <VBox alignment="TOP_CENTER" layoutX="70" layoutY="40" spacing="20" style="-fx-background-color: white;
    -fx-background-radius: 20;
    -fx-border-radius: 20;
    -fx-padding: 30;
    -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 10, 0, 0, 4);
    -fx-pref-width: 760; -fx-pref-height: 520;">

        <HBox alignment="CENTER_RIGHT" style="-fx-padding: 0 20 0 20;">
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnCerrarSesion" onAction="#onCerrarSesion" style="-fx-background-color: #E63946;
            -fx-text-fill: white;
            -fx-font-weight: bold;
            -fx-background-radius: 10;" text="Cerrar sesión" />
        </HBox>

        <ImageView fx:id="logoEmkauri" fitHeight="100" fitWidth="250" preserveRatio="true" smooth="true">
            <Image url="@/img/Emkauri_logo.png" />
        </ImageView>


        <Label fx:id="lblBienvenida" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2E3A59;" text="¡Bienvenido, Reclutador!" />

        <VBox alignment="TOP_CENTER" prefWidth="720" spacing="25">

            <Label style="-fx-font-size: 16px; -fx-text-fill: #2E3A59;" text="Selecciona el tipo de solicitud que deseas revisar" />

            <Button fx:id="btnSolicitudesProducto" onAction="#onSolicitudesProducto" style="-fx-background-color: #4A90E2;
            -fx-text-fill: white;
            -fx-font-weight: bold;
            -fx-background-radius: 8;
            -fx-padding: 12 40;
            -fx-cursor: hand;" text="Solicitudes de Producto" />

            <Button fx:id="btnSolicitudesEmprendedor" onAction="#onSolicitudesEmprendedor" style="-fx-background-color: white;
            -fx-border-color: #4A90E2;
            -fx-text-fill: #4A90E2;
            -fx-font-weight: bold;
            -fx-background-radius: 8;
            -fx-border-radius: 8;
            -fx-padding: 12 40;
            -fx-cursor: hand;" text="Solicitudes de Emprendedor" />

        </VBox>
    </VBox>
</AnchorPane>
