<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<!-- ARCHIVO FXML PARA LA PANTALLA DEL CLIENTE -->
<AnchorPane styleClass="root-pane" stylesheets="@../css/interfaz.css" xmlns:fx="http://javafx.com/fxml" fx:controller="controladores.ClienteController">
    <VBox alignment="TOP_CENTER" spacing="36" styleClass="content-card"
            AnchorPane.bottomAnchor="40"
            AnchorPane.leftAnchor="80"
            AnchorPane.rightAnchor="80"
            AnchorPane.topAnchor="40">

        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="top-bar">
            <VBox spacing="4">
                <Label fx:id="lblBienvenidaTop" styleClass="title" text="¡Bienvenid@, Cliente!" />
                <Label styleClass="subtitle" text="Accede a las secciones principales desde aquí" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT" spacing="14">
                <Button fx:id="btnCatalogo" onAction="#onVerCatalogo" styleClass="nav-button" text="Catálogo" />
                <Button fx:id="btnMisProductos" onAction="#onVerMisProductos" styleClass="nav-button" text="Mis Productos" />
                <Button fx:id="btnCarrito" onAction="#onVerCarrito" styleClass="cart-button" text="🛒" />
                <Button fx:id="btnCerrarSesion" onAction="#onCerrarSesion" styleClass="logout-button" text="Cerrar sesión" />
            </HBox>
        </HBox>

        <Separator styleClass="separator" />
        <VBox alignment="CENTER" spacing="24">
            <ImageView fx:id="welcomeIllustration" fitHeight="180" preserveRatio="true">
                <image> <Image url="@../img/Emkauri_logo.png" /> </image>
            </ImageView>

            <Label styleClass="section-title" text="Tu espacio para explorar productos y servicios" />
            <Label styleClass="section-subtitle" text="Usa los botones de arriba o selecciona una opción abajo" />

            <HBox alignment="CENTER" spacing="20">
                <Button fx:id="btnIrCatalogo" onAction="#onVerCatalogo" styleClass="primary-button" text="Ir al Catálogo" />
                <Button fx:id="btnIrMisProductos" onAction="#onVerMisProductos" styleClass="secondary-button" text="Mis Productos" />
            </HBox>
        </VBox>

        <Region VBox.vgrow="ALWAYS" />
        <HBox alignment="CENTER"> <Label styleClass="footer-text" text="© 2025 Emkauri — Todos los derechos reservados" /></HBox>
    </VBox>
</AnchorPane>
