<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>

<!-- ARCHIVO FXML PARA LA PANTALLA DEL CARRITO DE COMPRAS -->
<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="controladores.CarritoController" stylesheets="@../css/interfaz.css" styleClass="root-pane">
    <VBox alignment="CENTER" maxWidth="950" spacing="20" styleClass="content-box">
        <effect> <DropShadow color="#00000055" radius="10"/> </effect>

        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="section-header">
            <Label text="🛒 Carrito de Compras" styleClass="title-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnVolver" text="Volver" onAction="#handleVolver" styleClass="btn-secondary"/>
        </HBox>

        <TableView fx:id="tablaCarrito" prefHeight="350" prefWidth="809.0" styleClass="styled-table">
            <columns>
                <TableColumn fx:id="colNombre" prefWidth="260" text="Producto"/>
                <TableColumn fx:id="colTipo" prefWidth="150" text="Tipo"/>
                <TableColumn fx:id="colEmprendedor" prefWidth="220" text="Emprendedor"/>
                <TableColumn fx:id="colPrecio" prefWidth="180" text="Precio (COP)"/>
            </columns>
        </TableView>

        <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="total-box">
            <Label text="Total:" styleClass="total-label"/>
            <Label fx:id="lblTotal" text="0.00" styleClass="total-value"/>
        </HBox>

        <HBox alignment="CENTER" spacing="20" styleClass="bottom-buttons">
            <Button fx:id="btnEliminar" text="Eliminar Seleccionado" onAction="#handleEliminar" styleClass="btn-secondary"/>
            <Button fx:id="btnVaciar" text="Vaciar Carrito" onAction="#handleVaciar" styleClass="btn-danger"/>
            <Button fx:id="btnPagar" text="Proceder al Pago" onAction="#handlePagar" styleClass="btn-primary"/>
        </HBox>
    </VBox>
</StackPane>
