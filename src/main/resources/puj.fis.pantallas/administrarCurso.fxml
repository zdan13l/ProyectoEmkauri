<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- ARCHIVO FXML PARA LA PANTALLA DE ADMINISTRAR CURSO -->
<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="controladores.AdminProductoController" styleClass="fondo-celeste" stylesheets="@../css/interfaz.css">
    <VBox alignment="TOP_CENTER" spacing="25" styleClass="content-card"
            AnchorPane.topAnchor="40"
            AnchorPane.bottomAnchor="30"
            AnchorPane.leftAnchor="60"
            AnchorPane.rightAnchor="60">

        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="Administrar Curso" styleClass="title-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnVolver" text="Volver" onAction="#onVolver" styleClass="btn-danger"/>
        </HBox>
        <Separator styleClass="separator"/>

        <ScrollPane fitToWidth="true" styleClass="scroll-pane" hbarPolicy="NEVER">
            <content>
                <VBox alignment="TOP_CENTER" spacing="20" prefWidth="760">
                    <VBox alignment="CENTER_LEFT" spacing="6">
                        <Label text="Título" styleClass="section-title"/>
                        <TextField fx:id="txtTitulo" promptText="Ej: Curso de Marketing Digital" styleClass="input-field"/>
                    </VBox>

                    <VBox alignment="CENTER_LEFT" spacing="6">
                        <Label text="Descripción" styleClass="section-title"/>
                        <TextArea fx:id="txtDescripcion" prefRowCount="3" wrapText="true" promptText="Describe brevemente el curso..." styleClass="input-field"/>
                    </VBox>

                    <HBox spacing="18">
                        <VBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="Precio (COP)" styleClass="section-title"/>
                            <TextField fx:id="txtPrecio" promptText="Ej: 49999" styleClass="input-field"/>
                        </VBox>

                        <VBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="Duración (horas)" styleClass="section-title"/>
                            <TextField fx:id="txtDuracionCurso" promptText="Ej: 20" styleClass="input-field"/>
                        </VBox>

                        <VBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="Nivel de dificultad" styleClass="section-title"/>
                            <TextField fx:id="txtNivel" promptText="Ej: Intermedio" styleClass="input-field"/>
                        </VBox>
                    </HBox>

                    <VBox alignment="CENTER_LEFT" spacing="6">
                        <Label text="Certificación" styleClass="section-title"/>
                        <TextField fx:id="txtCertificacion" promptText="Ej: Certificado de finalización" styleClass="input-field"/>
                    </VBox>
                    <Separator styleClass="separator"/>

                    <Label text="Materiales del Curso" styleClass="section-title"/>
                    <TableView fx:id="tablaMateriales" prefHeight="190" styleClass="styled-table">
                        <columns>
                            <TableColumn fx:id="colTituloMat" text="Título" prefWidth="200"/>
                            <TableColumn fx:id="colTipoMat" text="Tipo" prefWidth="160"/>
                            <TableColumn fx:id="colUrlMat" text="URL / Archivo" prefWidth="350"/>
                        </columns>
                    </TableView>

                    <HBox spacing="12" alignment="CENTER">
                        <Button fx:id="btnAgregarMaterial" text="Agregar Material" onAction="#onAgregarMaterial" styleClass="green-button"/>
                        <Button fx:id="btnEliminarMaterial" text="Eliminar Seleccionado" onAction="#onEliminarMaterial" styleClass="btn-danger"/>
                    </HBox>
                    <Separator styleClass="separator"/>

                    <Button fx:id="btnGuardar" text="Guardar Cambios" onAction="#onGuardar" styleClass="primary-button"/>
                </VBox>
            </content>
        </ScrollPane>
    </VBox>
</AnchorPane>
