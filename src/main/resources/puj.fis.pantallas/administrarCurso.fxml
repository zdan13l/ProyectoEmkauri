<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="700.0" prefWidth="880.0" style="-fx-background-color: linear-gradient(to bottom right, #4A90E2, #50C9CE); -fx-font-family: 'Segoe UI';" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controladores.AdminProductoController">

    <VBox alignment="TOP_CENTER" spacing="22" style="-fx-background-color: white; -fx-background-radius: 16;                  -fx-padding: 30 40; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10,0,0,3);" AnchorPane.bottomAnchor="30" AnchorPane.leftAnchor="60" AnchorPane.rightAnchor="60" AnchorPane.topAnchor="40">

        <!-- HEADER -->
        <HBox alignment="CENTER" spacing="12">
            <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="28.0" prefWidth="575.0" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2E3A59;" text="Administrar Curso" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnVolver" onAction="#onVolver" style="-fx-background-color: #E94E77; -fx-text-fill: white; -fx-font-weight: bold;                            -fx-background-radius: 10; -fx-padding: 8 20; -fx-cursor: hand;" text="Volver" />
        </HBox>

        <Separator />

        <!-- FORM -->
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;">
            <content>
                <VBox alignment="TOP_CENTER" prefWidth="750" spacing="16">

                    <!-- Información general -->
                    <VBox alignment="CENTER_LEFT" spacing="8">
                        <Label style="-fx-font-weight: bold;" text="Título" />
                        <TextField fx:id="txtTitulo" promptText="Ej: Curso de Marketing Digital" style="-fx-background-radius: 8; -fx-border-color: #C9D7F2; -fx-padding: 6;" />
                    </VBox>

                    <VBox alignment="CENTER_LEFT" spacing="8">
                        <Label style="-fx-font-weight: bold;" text="Descripción" />
                        <TextArea fx:id="txtDescripcion" prefRowCount="3" promptText="Describe brevemente el curso..." style="-fx-background-radius: 8; -fx-border-color: #C9D7F2; -fx-padding: 8;" wrapText="true" />
                    </VBox>

                    <HBox spacing="18">
                        <VBox alignment="CENTER_LEFT" spacing="6">
                            <Label style="-fx-font-weight: bold;" text="Precio (COP)" />
                            <TextField fx:id="txtPrecio" promptText="Ej: 49999" style="-fx-background-radius: 8; -fx-border-color: #C9D7F2; -fx-padding: 6;" />
                        </VBox>

                        <VBox alignment="CENTER_LEFT" spacing="6">
                            <Label style="-fx-font-weight: bold;" text="Duración (horas)" />
                            <TextField fx:id="txtDuracionCurso" promptText="Ej: 20" style="-fx-background-radius: 8; -fx-border-color: #C9D7F2; -fx-padding: 6;" />
                        </VBox>

                        <VBox alignment="CENTER_LEFT" spacing="6">
                            <Label style="-fx-font-weight: bold;" text="Nivel de dificultad" />
                            <TextField fx:id="txtNivel" promptText="Ej: Intermedio" style="-fx-background-radius: 8; -fx-border-color: #C9D7F2; -fx-padding: 6;" />
                        </VBox>
                    </HBox>

                    <VBox alignment="CENTER_LEFT" spacing="6">
                        <Label style="-fx-font-weight: bold;" text="Certificación" />
                        <TextField fx:id="txtCertificacion" promptText="Ej: Certificado de finalización" style="-fx-background-radius: 8; -fx-border-color: #C9D7F2; -fx-padding: 6;" />
                    </VBox>

                    <Separator style="-fx-opacity: 0.4;" />

                    <!-- Sección materiales -->
                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2E3A59;" text="Materiales del Curso" />

                    <TableView fx:id="tablaMateriales" prefHeight="180" style="-fx-border-color: #C9D7F2; -fx-border-radius: 8; -fx-background-radius: 8;">
                        <columns>
                            <TableColumn fx:id="colTituloMat" prefWidth="220" text="Título" />
                            <TableColumn fx:id="colTipoMat" prefWidth="140" text="Tipo" />
                            <TableColumn fx:id="colUrlMat" prefWidth="320" text="URL / Archivo" />
                        </columns>
                    </TableView>

                    <HBox alignment="CENTER_RIGHT" spacing="10">
                        <Button fx:id="btnAgregarMaterial" onAction="#onAgregarMaterial" style="-fx-background-color: #27AE60; -fx-text-fill: white; -fx-font-weight: bold;                                        -fx-background-radius: 8; -fx-padding: 8 20;" text="Agregar Material" />
                        <Button fx:id="btnEliminarMaterial" onAction="#onEliminarMaterial" style="-fx-background-color: #E94E77; -fx-text-fill: white; -fx-font-weight: bold;                                        -fx-background-radius: 8; -fx-padding: 8 20;" text="Eliminar Seleccionado" />
                    </HBox>

                    <Separator style="-fx-opacity: 0.4;" />

                    <Button fx:id="btnGuardar" onAction="#onGuardar" style="-fx-background-color: #4A90E2; -fx-text-fill: white; -fx-font-weight: bold;                                    -fx-background-radius: 8; -fx-padding: 10 40; -fx-cursor: hand;" text="Guardar Cambios" />
                </VBox>
            </content>
        </ScrollPane>
    </VBox>
</AnchorPane>
