<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- ARCHIVO FXML PARA LA PANTALLA DE PAGO -->
<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="controladores.PagoController" stylesheets="@../css/interfaz.css" styleClass="root-pane">
    <VBox alignment="CENTER" maxWidth="600" spacing="24" styleClass="content-card">
        <Label text="💳 Pago Seguro" styleClass="title" />
        <Label text="Por favor ingresa tu información de pago para completar la compra." styleClass="subtitle" />

        <GridPane alignment="CENTER" hgap="20" vgap="16">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" minWidth="150" />
                <ColumnConstraints halignment="LEFT" minWidth="300" />
            </columnConstraints>

            <Label text="Nombre del titular:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="txtTitular" promptText="Ej: Juan Pérez" styleClass="input-field" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label text="Número de tarjeta:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="txtNumeroTarjeta" promptText="XXXX-XXXX-XXXX-XXXX" styleClass="input-field" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="Fecha de vencimiento:" GridPane.columnIndex="0" GridPane.rowIndex="2" />

            <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="2">
                <TextField fx:id="txtMes" prefWidth="60" promptText="MM" styleClass="input-field"/>
                <TextField fx:id="txtAnio" prefWidth="60" promptText="AAAA" styleClass="input-field"/>
            </HBox>

            <Label text="Código CVV:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <PasswordField fx:id="txtCVV" prefWidth="80" promptText="***" styleClass="input-field" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <Label text="Correo de contacto:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
            <TextField fx:id="txtCorreo" promptText="ejemplo@email.com" styleClass="input-field" GridPane.columnIndex="1" GridPane.rowIndex="4" />
        </GridPane>

        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Label text="Total a pagar:" styleClass="section-title" />
            <Label fx:id="lblTotalPago" text="0.00" styleClass="section-title" />
        </HBox>

        <HBox alignment="CENTER" spacing="20">
            <Button fx:id="btnCancelar" text="Cancelar" onAction="#handleCancelar" styleClass="secondary-button" />
            <Button fx:id="btnConfirmarPago" text="Confirmar Pago" onAction="#handleConfirmarPago" styleClass="primary-button" />
        </HBox>
    </VBox>
</StackPane>
