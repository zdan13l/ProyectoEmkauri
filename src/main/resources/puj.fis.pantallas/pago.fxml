<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>

<StackPane style="-fx-background-color: linear-gradient(to bottom right, #4A90E2, #50C9CE);" xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="controladores.PagoController">

    <VBox alignment="CENTER" maxWidth="600" spacing="24" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 40;">
        <effect> <DropShadow color="#00000055" radius="10" /> </effect>

        <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="💳 Pago Seguro" />
        <Label style="-fx-font-size: 13px; -fx-text-fill: #777777;" text="Por favor ingresa tu información de pago para completar la compra." />

        <GridPane alignment="CENTER" hgap="20" vgap="16">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" minWidth="150" />
                <ColumnConstraints halignment="LEFT" minWidth="300" />
            </columnConstraints>

            <Label style="-fx-font-weight: bold; -fx-text-fill: #333333;" text="Nombre del titular:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="txtTitular" promptText="Ej: Juan Pérez" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label style="-fx-font-weight: bold; -fx-text-fill: #333333;" text="Número de tarjeta:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="txtNumeroTarjeta" promptText="XXXX-XXXX-XXXX-XXXX" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label style="-fx-font-weight: bold; -fx-text-fill: #333333;" text="Fecha de vencimiento:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="2">
                <TextField fx:id="txtMes" prefWidth="60" promptText="MM" />
                <TextField fx:id="txtAnio" prefWidth="60" promptText="AA" />
            </HBox>

            <Label style="-fx-font-weight: bold; -fx-text-fill: #333333;" text="Código CVV:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <PasswordField fx:id="txtCVV" prefWidth="80" promptText="***" GridPane.columnIndex="1" GridPane.rowIndex="3" />

            <Label style="-fx-font-weight: bold; -fx-text-fill: #333333;" text="Correo de contacto:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
            <TextField fx:id="txtCorreo" promptText="ejemplo@email.com" GridPane.columnIndex="1" GridPane.rowIndex="4" />

            <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            </rowConstraints>
        </GridPane>

        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="Total a pagar:" />
            <Label fx:id="lblTotalPago" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #4A90E2;" text="0.00" />
        </HBox>

        <HBox alignment="CENTER" spacing="20">
            <Button fx:id="btnCancelar" onAction="#handleCancelar" style="-fx-background-color: transparent; -fx-border-color: #4A90E2;
            -fx-text-fill: #4A90E2; -fx-font-weight: bold; -fx-border-radius: 8; -fx-padding: 10 25; -fx-cursor: hand;" text="Cancelar" />
            <Button fx:id="btnConfirmarPago" onAction="#handleConfirmarPago" style="-fx-background-color: #4A90E2; -fx-text-fill: white;
            -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 25; -fx-cursor: hand;" text="Confirmar Pago" />
        </HBox>
    </VBox>
</StackPane>
