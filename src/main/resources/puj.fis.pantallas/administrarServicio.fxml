<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- ARCHIVO FXML PARA LA PANTALLA DE ADMINISTRAR SERVICIO -->
<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="controladores.AdminProductoController" styleClass="root-pane" stylesheets="@../css/interfaz.css">
    <VBox alignment="TOP_CENTER" spacing="22" styleClass="content-card"
            AnchorPane.topAnchor="40"
            AnchorPane.bottomAnchor="30"
            AnchorPane.leftAnchor="60"
            AnchorPane.rightAnchor="60">

        <HBox alignment="CENTER" spacing="12">
            <Label text="Administrar Servicio" styleClass="title-label" />
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnVolver" text="Volver" onAction="#onVolver" styleClass="btn-danger" />
        </HBox>
        <Separator styleClass="separator"/>

        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;">
            <content>
                <VBox alignment="TOP_CENTER" spacing="18" prefWidth="750">
                    <VBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="Título" styleClass="section-title"/>
                        <TextField fx:id="txtTitulo" promptText="Ej: Consultoría Financiera" styleClass="input-field"/>
                    </VBox>

                    <VBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="Descripción" styleClass="section-title"/>
                        <TextArea fx:id="txtDescripcion" promptText="Describe brevemente el servicio..." wrapText="true" prefRowCount="3" styleClass="input-field"/>
                    </VBox>

                    <HBox spacing="18">
                        <VBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="Precio (COP)" styleClass="section-title"/>
                            <TextField fx:id="txtPrecio" promptText="Ej: 80000" styleClass="input-field"/>
                        </VBox>

                        <VBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="Duración (minutos)" styleClass="section-title"/>
                            <TextField fx:id="txtDuracionServicio" promptText="Ej: 60" styleClass="input-field"/>
                        </VBox>
                    </HBox>

                    <VBox alignment="CENTER_LEFT" spacing="6">
                        <Label text="Ubicación" styleClass="section-title"/>
                        <TextField fx:id="txtUbicacion" promptText="Ej: En línea o Bogotá" styleClass="input-field"/>
                    </VBox>

                    <VBox alignment="CENTER_LEFT" spacing="6">
                        <Label text="Modalidad" styleClass="section-title"/>
                        <TextField fx:id="txtModalidad" promptText="Presencial / Virtual" styleClass="input-field"/>
                    </VBox>
                    <Separator styleClass="separator"/>

                    <Button fx:id="btnGuardar" text="Guardar Cambios" onAction="#onGuardar" styleClass="primary-button"/>
                </VBox>
            </content>
        </ScrollPane>
    </VBox>
</AnchorPane>
