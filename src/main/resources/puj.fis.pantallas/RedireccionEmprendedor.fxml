<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="600" prefWidth="900" style="-fx-background-color: linear-gradient(to bottom right, #4A90E2, #50C9CE);" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controladores.ControladorPrincipalEmprendedor">

    <!-- Panel principal tipo tarjeta -->
    <VBox alignment="TOP_CENTER" layoutX="70" layoutY="40" spacing="20" style="-fx-background-color: white;                  -fx-background-radius: 20;                  -fx-border-radius: 20;                  -fx-padding: 30;                  -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 10, 0, 0, 4);                  -fx-pref-width: 760; -fx-pref-height: 520;">

        <!-- Botón de cerrar sesión -->
        <HBox alignment="CENTER_RIGHT" style="-fx-padding: 0 20 0 20;">
         <children>
               <Region />
               <Button fx:id="btnCerrarSesion" style="-fx-background-color: #E63946;                         -fx-text-fill: white;                         -fx-font-weight: bold;                         -fx-background-radius: 10;" text="Cerrar sesión" />
         </children>
        </HBox>

        <!-- Logo centrado -->
        <ImageView fx:id="logoEmkauri" fitHeight="100" fitWidth="250" preserveRatio="true" smooth="true">
            <Image url="@/img/Emkauri_logo.png" />
        </ImageView>

        <!-- Bienvenida -->
        <Label fx:id="lblBienvenida" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2E3A59;" text="¡Bienvenido, Emprendedor!" />

        <!-- Contenedor principal -->
        <VBox alignment="TOP_CENTER" prefHeight="400" prefWidth="720" spacing="15">

            <!-- Primera fila de botones -->
            <HBox alignment="CENTER" spacing="15">
                <Button fx:id="btnCrearServicio" style="-fx-background-color: #4A90E2;                            -fx-text-fill: white;                            -fx-font-weight: bold;                            -fx-background-radius: 8;                            -fx-padding: 10 20;                            -fx-cursor: hand;" text="Crear Servicio" />

                <Button fx:id="btnCrearCurso" style="-fx-background-color: #4A90E2;                            -fx-text-fill: white;                            -fx-font-weight: bold;                            -fx-background-radius: 8;                            -fx-padding: 10 20;                            -fx-cursor: hand;" text="Crear Curso" />
            </HBox>

            <!-- Segunda fila de botones -->
            <HBox alignment="CENTER" spacing="15">
                <Button fx:id="btnAdminCalificaciones" style="-fx-background-color: white;                            -fx-border-color: #4A90E2;                            -fx-text-fill: #4A90E2;                            -fx-font-weight: bold;                            -fx-background-radius: 8;                            -fx-border-radius: 8;                            -fx-padding: 10 20;                            -fx-cursor: hand;" text="Administrar Calificaciones" />

                <Button fx:id="btnMisServicios" style="-fx-background-color: white;                            -fx-border-color: #4A90E2;                            -fx-text-fill: #4A90E2;                            -fx-font-weight: bold;                            -fx-background-radius: 8;                            -fx-border-radius: 8;                            -fx-padding: 10 20;                            -fx-cursor: hand;" text="Mis Servicios" />

                <Button fx:id="btnMisCursos" style="-fx-background-color: white;                            -fx-border-color: #4A90E2;                            -fx-text-fill: #4A90E2;                            -fx-font-weight: bold;                            -fx-background-radius: 8;                            -fx-border-radius: 8;                            -fx-padding: 10 20;                            -fx-cursor: hand;" text="Mis Cursos" />
            </HBox>

            <!-- Sección informativa -->
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2E3A59;" text="Gestiona tus cursos y servicios" />

            <ScrollPane fitToWidth="true" prefHeight="350" prefWidth="680" style="-fx-background-color: transparent; -fx-border-color: transparent;">
                <VBox fx:id="contenedorElementos" alignment="TOP_CENTER" spacing="10" style="-fx-padding: 10;">
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #2E3A59;" text="Aquí se mostrarán tus cursos y servicios..." />
                </VBox>
            </ScrollPane>

        </VBox>
    </VBox>
</AnchorPane>
