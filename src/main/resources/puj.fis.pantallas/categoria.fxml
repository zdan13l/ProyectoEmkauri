<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- ARCHIVO FXML PARA LA GESTIÓN DE CATEGORÍAS-->
<AnchorPane styleClass="root-pane" stylesheets="@../css/interfaz.css" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controladores.CategoriaController">
    <VBox alignment="TOP_CENTER" spacing="20"
            AnchorPane.bottomAnchor="20"
            AnchorPane.leftAnchor="20"
            AnchorPane.rightAnchor="20"
            AnchorPane.topAnchor="20">

        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="content-card">
            <Label styleClass="title" text="📁 Gestión de Categorías" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnVolver" onAction="#onVolver" styleClass="secondary-button" text="Volver" />
        </HBox>

        <VBox spacing="20" styleClass="content-card">
            <GridPane hgap="14" vgap="12">
                <columnConstraints>
                    <ColumnConstraints percentWidth="25" />
                    <ColumnConstraints percentWidth="75" />
                </columnConstraints>

                <Label styleClass="section-title" text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtNombre" promptText="Ingrese el nombre de la categoría" styleClass="input-field" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label styleClass="section-title" text="Descripción:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="txtDescripcion" promptText="Ingrese una breve descripción" styleClass="input-field" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label styleClass="section-title" text="Búsqueda:" GridPane.columnIndex="0" GridPane.rowIndex="2" />

                <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <TextField fx:id="txtBuscar" promptText="Nombre de categoría" styleClass="input-field" HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnBuscar" onAction="#handleBuscar" styleClass="primary-button" text="Buscar" />
                </HBox>

                <rowConstraints>
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                </rowConstraints>
            </GridPane>

            <HBox spacing="12">
                <Button fx:id="btnAgregar" onAction="#handleAgregar" styleClass="green-button" text="Agregar" />
                <Button fx:id="btnActualizar" onAction="#handleActualizar" styleClass="yellow-button" text="Actualizar" />
                <Button fx:id="btnEliminar" onAction="#handleEliminar" styleClass="red-button" text="Eliminar" />
                <Button fx:id="btnLimpiar" onAction="#handleLimpiar" styleClass="gray-button" text="Limpiar" />
                <Button fx:id="btnListar" onAction="#handleListar" styleClass="primary-button" text="Listar" />
            </HBox>

            <TableView fx:id="tablaCategorias" prefHeight="260" style="-fx-background-radius: 10;">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="80" text="ID" />
                    <TableColumn fx:id="colNombre" prefWidth="220" text="Nombre" />
                    <TableColumn fx:id="colDescripcion" prefWidth="450" text="Descripción" />
                </columns>
                <columnResizePolicy> <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /> </columnResizePolicy>
            </TableView>
        </VBox>
    </VBox>
</AnchorPane>
