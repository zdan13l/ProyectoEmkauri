<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="controladores.RegistroController" style="-fx-background-color: linear-gradient(to bottom right, #4A90E2, #50C9CE);">

    <VBox alignment="CENTER" spacing="15.0" maxWidth="400" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 30;">

        <effect> <DropShadow color="#00000055"/> </effect>

        <Label text="Crea tu cuenta" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>

        <Label text="Regístrate para unirte a Emkauri" style="-fx-font-size: 13px; -fx-text-fill: #777777;"/>

        <TextField fx:id="nombreField" promptText="Nombre" style="-fx-background-radius: 8; -fx-padding: 8; -fx-border-radius: 8;
                        -fx-border-color: #cccccc; -fx-background-color: #f9f9f9;"/>

        <TextField fx:id="apellidoField" promptText="Apellido" style="-fx-background-radius: 8; -fx-padding: 8; -fx-border-radius: 8;
                        -fx-border-color: #cccccc; -fx-background-color: #f9f9f9;"/>

        <TextField fx:id="telefonoField" promptText="Teléfono" style="-fx-background-radius: 8; -fx-padding: 8; -fx-border-radius: 8;
                        -fx-border-color: #cccccc; -fx-background-color: #f9f9f9;"/>

        <TextField fx:id="emailField" promptText="Correo electrónico" style="-fx-background-radius: 8; -fx-padding: 8; -fx-border-radius: 8;
                        -fx-border-color: #cccccc; -fx-background-color: #f9f9f9;"/>

        <PasswordField fx:id="passwordField" promptText="Contraseña" style="-fx-background-radius: 8; -fx-padding: 8; -fx-border-radius: 8;
                            -fx-border-color: #cccccc; -fx-background-color: #f9f9f9;"/>

        <Label text="Tipo de cuenta:" style="-fx-font-size: 13px; -fx-text-fill: #555555;"/>

        <HBox alignment="CENTER" spacing="12">
            <RadioButton fx:id="clienteRadio" text="Cliente" toggleGroup="$tipoUsuarioGroup" style="-fx-font-size: 13px; -fx-text-fill: #4A90E2;"/>
            <RadioButton fx:id="emprendedorRadio" text="Emprendedor" toggleGroup="$tipoUsuarioGroup" style="-fx-font-size: 13px; -fx-text-fill: #4A90E2;"/>
        </HBox>

        <VBox fx:id="emprendedorBox" spacing="8" visible="false" managed="false" style="-fx-padding: 8 0 0 0;">
            <TextArea fx:id="mensajeField" promptText="Mensaje para el reclutador o descripción breve" prefRowCount="3" style="-fx-background-radius: 8; -fx-border-color: #cccccc;"/>
        </VBox>

        <Button text="Registrarse" onAction="#onRegistrarClick" style="-fx-background-color: #4A90E2; -fx-text-fill: white; -fx-font-weight: bold;
                    -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;"/>

        <Button text="Volver al inicio de sesión" onAction="#onVolverClick" style="-fx-background-color: transparent; -fx-text-fill: #4A90E2; -fx-font-weight: bold;
                    -fx-border-color: #4A90E2; -fx-border-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;"/>
    </VBox>
</StackPane>
