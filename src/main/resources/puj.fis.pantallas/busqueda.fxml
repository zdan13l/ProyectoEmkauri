<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="controladores.BusquedaController"
           style="-fx-background-color: linear-gradient(to bottom right, #4A90E2, #50C9CE);">

    <VBox alignment="CENTER" spacing="15.0" maxWidth="800"
          style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 30;">

        <effect>
            <DropShadow radius="10" color="#00000055"/>
        </effect>

        <Label text="Búsqueda de Cursos y Servicios"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>

        <HBox alignment="CENTER" spacing="10">
            <TextField fx:id="busquedaField" promptText="Buscar por nombre, descripción..." HBox.hgrow="ALWAYS"
                       style="-fx-background-radius: 8; -fx-padding: 8; -fx-border-radius: 8;
                              -fx-border-color: #cccccc; -fx-background-color: #f9f9f9;"/>
            <ComboBox fx:id="categoriaFilter" promptText="Filtrar por Categoría"
                      style="-fx-background-radius: 8; -fx-padding: 8; -fx-border-radius: 8;
                             -fx-border-color: #cccccc; -fx-background-color: #f9f9f9;"/>
            <Button text="Buscar" onAction="#onSearchClick"
                    style="-fx-background-color: #4A90E2; -fx-text-fill: white; -fx-font-weight: bold;
                           -fx-background-radius: 8; -fx-padding: 8 20; -fx-cursor: hand;"/>
        </HBox>

        <TableView fx:id="resultadosTable" prefHeight="400" prefWidth="700">
            <columns>
                <TableColumn fx:id="tipoColumn" text="Tipo"/>
                <TableColumn fx:id="nombreColumn" text="Nombre"/>
                <TableColumn fx:id="descripcionColumn" text="Descripción"/>
                <TableColumn fx:id="categoriaColumn" text="Categoría"/>
                <TableColumn fx:id="precioColumn" text="Precio"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

    </VBox>
</StackPane>