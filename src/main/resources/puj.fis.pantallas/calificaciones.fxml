<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- ARCHIVO FXML PARA LA PANTALLA DE CALIFICACIONES DE PRODUCTOS -->
<AnchorPane styleClass="fondo-celeste" stylesheets="@../css/interfaz.css" xmlns:fx="http://javafx.com/fxml" fx:controller="controladores.CalificacionController">
    <VBox alignment="TOP_CENTER" spacing="30" styleClass="content-card"
            AnchorPane.bottomAnchor="50"
            AnchorPane.leftAnchor="80"
            AnchorPane.rightAnchor="80"
            AnchorPane.topAnchor="50">

        <HBox alignment="CENTER_LEFT" spacing="20">
            <VBox spacing="8">
                <Label styleClass="title-label" text="¡Bienvenid@, Emprendedor!" />
                <Label styleClass="subtitle-label" text="Consulta las calificaciones recibidas por tus productos, cursos o servicios." />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER_RIGHT" spacing="14">
                <Button fx:id="btnMisProductos" onAction="#onVerMisProductos" styleClass="nav-button" text="Mis Productos" />
                <Button fx:id="btnVolver" onAction="#onVolver" styleClass="logout-button" text="Volver" />
            </HBox>
        </HBox>
        <Separator prefWidth="720" styleClass="separator" />

        <VBox alignment="TOP_CENTER" prefHeight="420" prefWidth="850" spacing="20">
            <Label styleClass="title-label" text="Administrar Calificaciones" />
            <Label styleClass="subtitle-label" text="Consulta las calificaciones recibidas por tus productos, cursos o servicios." />

            <HBox alignment="CENTER" spacing="10">
                <Label styleClass="subtitle-label" text="Filtrar por:" />
                <ComboBox fx:id="comboTipo" prefHeight="56.0" prefWidth="180.0" promptText="Seleccionar tipo" styleClass="input-search">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Ambos" />
                            <String fx:value="Servicios" />
                            <String fx:value="Cursos" />
                        </FXCollections>
                    </items>
                </ComboBox>

                <ComboBox fx:id="comboElemento" prefHeight="56.0" prefWidth="270.0" promptText="Selecciona un elemento" styleClass="input-search" />
                <Spinner fx:id="spinPuntaje" editable="false" prefHeight="56.0" prefWidth="90.0" styleClass="input-search" />
            </HBox>

            <TableView fx:id="tablaCalificaciones" prefHeight="212.0" prefWidth="805.0" styleClass="styled-table">
                <columns>
                    <TableColumn fx:id="colProducto" prefWidth="180" text="Producto" />
                    <TableColumn fx:id="colCliente" prefWidth="150" text="Cliente" />
                    <TableColumn fx:id="colPuntaje" prefWidth="100" text="Puntaje" />
                    <TableColumn fx:id="colComentario" prefWidth="250" text="Comentario" />
                    <TableColumn fx:id="colFecha" prefWidth="120" text="Fecha" />
                </columns>
            </TableView>
            <Label fx:id="mensajeTablaVacia" styleClass="subtitle-label" text="No hay calificaciones registradas" />
        </VBox>

        <HBox alignment="CENTER" spacing="14" style="-fx-padding: 12;">
            <Button fx:id="btnBuscar" onAction="#onBuscar" styleClass="primary-button" text="Buscar" />
            <Button fx:id="btnSoloComentarios" onAction="#onFiltrarSoloComentarios" styleClass="secondary-button" text="Solo comentarios" />
            <Button fx:id="btnLimpiar" onAction="#onLimpiarFiltros" styleClass="gray-button" text="Limpiar filtros" />
        </HBox>

        <HBox alignment="CENTER" spacing="8" styleClass="total-box">
            <Label styleClass="card-text" text="Promedio general:" />
            <Label fx:id="lblPromedioGeneral" styleClass="total-value" text="0.0" />
        </HBox>
        <HBox alignment="CENTER"> <Label styleClass="footer-text" text="© 2025 Emkauri — Todos los derechos reservados" /> </HBox>
    </VBox>
</AnchorPane>
