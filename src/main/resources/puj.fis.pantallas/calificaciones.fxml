<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<AnchorPane prefHeight="700.0" prefWidth="960.0"
            style="-fx-background-color: linear-gradient(to bottom right, #4A90E2, #50C9CE);"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controladores.CalificacionController">

    <VBox alignment="TOP_CENTER" spacing="24"
          style="-fx-background-color: white; -fx-background-radius: 20; -fx-border-radius: 20;
                 -fx-padding: 32 48 40 48; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10,0,0,4);"
          AnchorPane.topAnchor="40" AnchorPane.bottomAnchor="40"
          AnchorPane.leftAnchor="80" AnchorPane.rightAnchor="80">

        <!-- CABECERA -->
        <HBox alignment="CENTER_LEFT" spacing="20">
            <VBox spacing="6">
                <Label style="-fx-font-size: 20px; -fx-font-weight: 700; -fx-text-fill: #2E3A59;"
                       text="¡Bienvenid@, Emprendedor!" />
                <Label style="-fx-font-size: 13px; -fx-text-fill: #7A8BA3;"
                       text="Consulta las calificaciones recibidas por tus productos, cursos o servicios" />
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER_RIGHT" spacing="14">
                <Button fx:id="btnMisProductos"
                        text="Mis Productos"
                        onAction="#onVerMisProductos"
                        style="-fx-background-color: transparent; -fx-text-fill: #2E3A59;
                               -fx-font-weight: 600;" />

                <Button fx:id="btnVolver"
                        text="Volver"
                        onAction="#onVolver"
                        style="-fx-background-color: #E63946; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 8 14;" />
            </HBox>
        </HBox>

        <Separator prefWidth="720" style="-fx-opacity: 0.3;" />

        <!-- CONTENIDO PRINCIPAL -->
        <VBox alignment="TOP_CENTER" spacing="20" prefHeight="400" prefWidth="800">

            <Label text="Administrar Calificaciones"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2E3A59;" />

            <Label text="Consulta las calificaciones recibidas por tus productos, cursos o servicios"
                   style="-fx-font-size: 13px; -fx-text-fill: #7A8BA3;" />

            <!-- FILTROS -->
            <HBox alignment="CENTER" spacing="10">
                <Label text="Filtrar por:" style="-fx-font-size: 13px; -fx-font-weight: bold;" />
                <ComboBox fx:id="comboTipo" prefWidth="160" promptText="Seleccionar tipo">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Ambos" />
                            <String fx:value="Servicios" />
                            <String fx:value="Cursos" />
                        </FXCollections>
                    </items>
                </ComboBox>
                <ComboBox fx:id="comboElemento" prefWidth="220" promptText="Selecciona un elemento" />
                <Button fx:id="btnBuscar"
                        text="Buscar"
                        onAction="#onBuscar"
                        style="-fx-background-color: #4A90E2; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" />
            </HBox>

            <!-- TABLA -->
            <TableView fx:id="tablaCalificaciones"
                       prefWidth="800" prefHeight="380"
                       style="-fx-border-color: #C9D7F2; -fx-border-radius: 10; -fx-background-radius: 10;">
                <columns>
                    <TableColumn fx:id="colProducto" text="Producto / Servicio" prefWidth="220" />
                    <TableColumn fx:id="colCliente" text="Cliente" prefWidth="160" />
                    <TableColumn fx:id="colPuntaje" text="Puntaje" prefWidth="100" />
                    <TableColumn fx:id="colComentario" text="Comentario" prefWidth="250" />
                    <TableColumn fx:id="colFecha" text="Fecha" prefWidth="120" />
                </columns>
            </TableView>

            <!-- MENSAJE DE TABLA VACÍA -->
            <Label fx:id="mensajeTablaVacia"
                   text="No hay calificaciones registradas"
                   style="-fx-font-size: 12px; -fx-text-fill: #7A8BA3;" />


        </VBox>

        <!-- PROMEDIO GENERAL -->
        <HBox alignment="CENTER" spacing="8" style="-fx-padding: 10 0 0 0;">
            <Label text="Promedio general:"
                   style="-fx-font-size: 14px; -fx-text-fill: #2E3A59;" />
            <Label fx:id="lblPromedioGeneral"
                   text="0.0"
                   style="-fx-font-size: 18px; -fx-text-fill: #4A90E2; -fx-font-weight: bold;" />
        </HBox>

        <!-- PIE DE PÁGINA -->
        <HBox alignment="CENTER">
            <Label style="-fx-font-size: 12px; -fx-text-fill: #7A7A7A;"
                   text="© 2025 Emkauri — Todos los derechos reservados" />
        </HBox>
    </VBox>
</AnchorPane>
