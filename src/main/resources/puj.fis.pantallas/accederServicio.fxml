<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- ARCHIVO FXML PARA LA PANTALLA DE ACCEDER A UN SERVICIO -->
<AnchorPane styleClass="fondo-celeste" xmlns:fx="http://javafx.com/fxml" fx:controller="controladores.AccederServicioController" stylesheets="@../css/interfaz.css">
    <VBox alignment="TOP_CENTER" spacing="24" styleClass="content-card"
            AnchorPane.topAnchor="40"
            AnchorPane.bottomAnchor="40"
            AnchorPane.leftAnchor="80"
            AnchorPane.rightAnchor="80">

        <HBox alignment="CENTER_LEFT" spacing="20">
            <VBox spacing="6">
                <Label text="Acceder a tu Servicio" styleClass="title-label" />
                <Label text="Aquí puedes comunicarte con el emprendedor que te brindó el servicio" styleClass="subtitle-label" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />

            <Button fx:id="btnVolver" text="Volver" onAction="#onVolver" styleClass="btn-danger" />
        </HBox>
        <Separator prefWidth="720" styleClass="separator" />

        <VBox alignment="CENTER" spacing="24" prefWidth="800">
            <HBox alignment="CENTER" spacing="12">
                <Label text="Servicio:" styleClass="section-title" />
                <Label fx:id="lblTituloServicio" text="—" styleClass="card-subtitle" prefWidth="300" />
            </HBox>
            <Separator prefWidth="600" styleClass="separator" />

            <VBox alignment="CENTER" spacing="14" prefWidth="600">
                <Label text="Información del Emprendedor" styleClass="section-title" />
                <HBox alignment="CENTER" spacing="10">
                    <Label text="Nombre:" styleClass="card-text" />
                    <Label fx:id="lblNombreEmprendedor" text="—" styleClass="card-subtitle" />
                </HBox>
                <HBox alignment="CENTER" spacing="10">
                    <Label text="Teléfono:" styleClass="card-text" />
                    <Label fx:id="lblTelefono" text="—" styleClass="card-subtitle" />
                </HBox>
                <Button fx:id="btnWhatsapp" text="Contactar por WhatsApp" onAction="#onContactarWhatsapp" styleClass="green-button" />
            </VBox>
        </VBox>
        <Region VBox.vgrow="ALWAYS" />

        <HBox alignment="CENTER">
            <Label text="© 2025 Emkauri — Todos los derechos reservados" styleClass="footer-text" />
        </HBox>
    </VBox>
</AnchorPane>
