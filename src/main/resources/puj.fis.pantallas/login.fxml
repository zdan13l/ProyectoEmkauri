<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- ARCHIVO FXML PARA LA PANTALLA DE LOGIN -->
<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="controladores.LoginController" stylesheets="@../css/loginRegister.css">
    <children>
        <VBox styleClass="fondo-celeste"
                AnchorPane.topAnchor="0"
                AnchorPane.bottomAnchor="0"
                AnchorPane.leftAnchor="0"
                AnchorPane.rightAnchor="0"
                alignment="CENTER">

            <VBox spacing="18" alignment="CENTER" maxWidth="420" styleClass="card-login">
                <Label text="Bienvenido a Emkauri" styleClass="titulo"/>
                <Label text="Inicia sesión para continuar" styleClass="subtitulo"/>

                <TextField fx:id="txtUsuario" promptText="Correo electrónico" styleClass="campo"/>
                <PasswordField fx:id="txtPassword" promptText="Contraseña" styleClass="campo"/>

                <Button text="Iniciar sesión" fx:id="btnIngresar" onAction="#onLoginClick" styleClass="btn-login"/>
                <Button text="Registrarse" fx:id="btnRegistro" onAction="#onRegisterClick" styleClass="btn-register"/>
            </VBox>
        </VBox>
    </children>
</AnchorPane>
