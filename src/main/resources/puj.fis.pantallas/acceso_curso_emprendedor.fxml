<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="controladores.AccesoCursoController"
           style="-fx-background-color: linear-gradient(to bottom right, #4A90E2, #50C9CE);">

    <VBox alignment="CENTER" spacing="18.0" maxWidth="1100"
          style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 24;">
        <effect><DropShadow color="#00000055"/></effect>

        <Label text="Acceso de Curso (Emprendedor)"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #333"/>
        <Label text="Selecciona un curso y gestiona sus materiales"
               style="-fx-font-size: 13px; -fx-text-fill: #777"/>

        <HBox spacing="16">
            <!-- CURSOS -->
            <VBox spacing="10" prefWidth="520">
                <Label text="Mis Cursos" style="-fx-font-weight: bold; -fx-text-fill: #333;"/>
                <TableView fx:id="tblCursos" prefHeight="420"
                           style="-fx-background-radius: 10; -fx-background-color: #fafafa;">
                    <columns>
                        <TableColumn fx:id="colCId" text="ID" prefWidth="70"/>
                        <TableColumn fx:id="colCTitulo" text="Título" prefWidth="200"/>
                        <TableColumn fx:id="colCCategoria" text="Categoría" prefWidth="130"/>
                        <TableColumn fx:id="colCPrecio" text="Precio" prefWidth="100"/>
                    </columns>
                </TableView>
                <HBox spacing="10">
                    <Button text="Refrescar cursos" onAction="#onRefrescarCursos"
                            style="-fx-background-color: transparent; -fx-text-fill: #4A90E2; -fx-font-weight: bold;
                                   -fx-border-color: #4A90E2; -fx-border-radius: 8; -fx-cursor: hand;"/>
                </HBox>
            </VBox>

            <!-- MATERIALES -->
            <VBox spacing="10" prefWidth="520">
                <Label text="Materiales del Curso" style="-fx-font-weight: bold; -fx-text-fill: #333;"/>
                <TableView fx:id="tblMateriales" prefHeight="280"
                           style="-fx-background-radius: 10; -fx-background-color: #fafafa;">
                    <columns>
                        <TableColumn fx:id="colMId" text="ID" prefWidth="70"/>
                        <TableColumn fx:id="colMTitulo" text="Título" prefWidth="200"/>
                        <TableColumn fx:id="colMTipo" text="Tipo" prefWidth="100"/>
                        <TableColumn fx:id="colMUrl" text="URL" prefWidth="150"/>
                    </columns>
                </TableView>

                <Label text="Nuevo / Editar material" style="-fx-font-weight: bold; -fx-text-fill: #333;"/>
                <GridPane hgap="10" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints prefWidth="90"/>
                        <ColumnConstraints prefWidth="190"/>
                    </columnConstraints>
                    <children>
                        <Label text="Título:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtMTitulo" GridPane.rowIndex="0" GridPane.columnIndex="1"
                                   promptText="p.ej. Introducción"
                                   style="-fx-background-radius: 8; -fx-padding: 8; -fx-background-color: #f9f9f9;"/>

                        <Label text="Tipo:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="cbMTipo" GridPane.rowIndex="1" GridPane.columnIndex="1"
                                  promptText="VIDEO / PDF / EXAMEN"
                                  style="-fx-background-radius: 8; -fx-padding: 2;"/>

                        <Label text="URL:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtMUrl" GridPane.rowIndex="2" GridPane.columnIndex="1"
                                   promptText="https://..."
                                   style="-fx-background-radius: 8; -fx-padding: 8; -fx-background-color: #f9f9f9;"/>
                    </children>
                </GridPane>

                <HBox spacing="8">
                    <Button text="Nuevo" onAction="#onNuevoMaterial"
                            style="-fx-background-color: #EEEEEE; -fx-background-radius: 8; -fx-cursor: hand;"/>
                    <Button text="Agregar" onAction="#onAgregarMaterial"
                            style="-fx-background-color: #4A90E2; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>
                    <Button text="Actualizar" onAction="#onActualizarMaterial"
                            style="-fx-background-color: #4A90E2; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>
                    <Button text="Eliminar" onAction="#onEliminarMaterial"
                            style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>
                    <Button text="Refrescar materiales" onAction="#onRefrescarMateriales"
                            style="-fx-background-color: transparent; -fx-text-fill: #4A90E2; -fx-font-weight: bold;
                                   -fx-border-color: #4A90E2; -fx-border-radius: 8; -fx-cursor: hand;"/>
                </HBox>
            </VBox>
        </HBox>
    </VBox>
</StackPane>
