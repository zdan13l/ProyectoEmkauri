<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- ARCHIVO FXML PARA EL CATÁLOGO DE PRODUCTOS -->
<StackPane styleClass="fondo-celeste" stylesheets="@../css/interfaz.css" xmlns:fx="http://javafx.com/fxml" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="controladores.CatalogoController">
    <VBox alignment="CENTER" maxWidth="900" spacing="20" styleClass="content-card">
        <HBox alignment="CENTER_LEFT" prefWidth="100" spacing="10">
            <Label styleClass="title" text="Catálogo de Productos" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnCarrito" onAction="#onVerCarrito" styleClass="cart-button" text="🛒" />
        </HBox>

        <HBox alignment="CENTER" spacing="12">
            <TextField fx:id="busquedaField" promptText="Buscar por nombre o descripción..." styleClass="input-field" HBox.hgrow="ALWAYS" />
            <ComboBox fx:id="categoriaFilter" promptText="Categoría" styleClass="input-field" />
            <Button onAction="#onSearchClick" styleClass="primary-button" text="Buscar" />
        </HBox>

        <TableView fx:id="resultadosTable" prefHeight="420" prefWidth="850" style="-fx-background-radius: 10;">
            <columns>
                <TableColumn fx:id="tipoColumn" prefWidth="107.0" text="Tipo" />
                <TableColumn fx:id="nombreColumn" prefWidth="221.0" text="Nombre" />
                <TableColumn fx:id="descripcionColumn" text="Descripción" />
                <TableColumn fx:id="categoriaColumn" prefWidth="190.0" text="Categoría" />
                <TableColumn fx:id="precioColumn" prefWidth="137.0" text="Precio" />
            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <HBox alignment="CENTER_RIGHT" spacing="20">
            <Button onAction="#onAgregarCarritoClick" styleClass="primary-button" text="Agregar al Carrito" />
            <Button onAction="#onVolverClick" styleClass="logout-button" text="Volver" />
        </HBox>
    </VBox>
</StackPane>
