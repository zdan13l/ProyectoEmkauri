<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="controladores.CategoriaController"
           style="-fx-background-color: linear-gradient(to bottom right, #4A90E2, #50C9CE);">

    <VBox alignment="TOP_CENTER" spacing="20" maxWidth="800"
          style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 30;">
        <effect>
            <DropShadow radius="10" color="#00000033"/>
        </effect>

        <!-- 🔹 Título -->
        <Label text="Gestión de Categorías"
               style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #333333;" />

        <!-- 🔹 Formulario -->
        <GridPane hgap="12" vgap="12" style="-fx-padding: 10;">
            <columnConstraints>
                <ColumnConstraints percentWidth="30"/>
                <ColumnConstraints percentWidth="70"/>
            </columnConstraints>

            <!-- Nombre -->
            <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0"
                   style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
            <TextField fx:id="txtNombre" promptText="Ingrese el nombre de la categoría"
                       GridPane.columnIndex="1" GridPane.rowIndex="0"
                       style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #cccccc; -fx-padding: 6;"/>

            <!-- Descripción -->
            <Label text="Descripción:" GridPane.columnIndex="0" GridPane.rowIndex="1"
                   style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
            <TextField fx:id="txtDescripcion" promptText="Ingrese una breve descripción"
                       GridPane.columnIndex="1" GridPane.rowIndex="1"
                       style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #cccccc; -fx-padding: 6;"/>

            <!-- Buscar -->
            <Label text="Buscar por nombre:" GridPane.columnIndex="0" GridPane.rowIndex="2"
                   style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
            <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="2">
                <TextField fx:id="txtBuscar" promptText="Nombre a buscar..." HBox.hgrow="ALWAYS"
                           style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #cccccc; -fx-padding: 6;"/>
                <Button fx:id="btnBuscar" text="Buscar" onAction="#handleBuscar"
                        style="-fx-background-color: #4A90E2; -fx-text-fill: white; -fx-font-weight: bold;
                               -fx-background-radius: 8; -fx-padding: 6 14;"/>
            </HBox>
        </GridPane>

        <!-- 🔹 Botones -->
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Button fx:id="btnAgregar" text="Agregar" onAction="#handleAgregar"
                    style="-fx-background-color: #27AE60; -fx-text-fill: white; -fx-font-weight: bold;
                           -fx-background-radius: 8; -fx-padding: 6 14;"/>
            <Button fx:id="btnActualizar" text="Actualizar" onAction="#handleActualizar"
                    style="-fx-background-color: #F39C12; -fx-text-fill: white; -fx-font-weight: bold;
                           -fx-background-radius: 8; -fx-padding: 6 14;"/>
            <Button fx:id="btnEliminar" text="Eliminar" onAction="#handleEliminar"
                    style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-weight: bold;
                           -fx-background-radius: 8; -fx-padding: 6 14;"/>
            <Button fx:id="btnLimpiar" text="Limpiar" onAction="#handleLimpiar"
                    style="-fx-background-color: #95A5A6; -fx-text-fill: white; -fx-font-weight: bold;
                           -fx-background-radius: 8; -fx-padding: 6 14;"/>
        </HBox>

        <!-- 🔹 Tabla -->
        <TableView fx:id="tablaCategorias" prefHeight="320" prefWidth="760"
                   style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #ccc; -fx-border-width: 1;">
            <columns>
                <TableColumn fx:id="colId" prefWidth="100" text="ID"/>
                <TableColumn fx:id="colNombre" prefWidth="240" text="Nombre"/>
                <TableColumn fx:id="colDescripcion" prefWidth="400" text="Descripción"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

    </VBox>
</StackPane>
