<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="controladores.CatalogoController" style="-fx-background-color: linear-gradient(to bottom right, #4A90E2, #50C9CE);">

    <VBox alignment="CENTER" spacing="15.0" maxWidth="850" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 30;">
        <effect> <DropShadow radius="10" color="#00000055"/> </effect>

        <HBox alignment="CENTER_LEFT" spacing="10" prefWidth="100">
            <Label text="Catálogo de Cursos y Servicios" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnCarrito" onAction="#onVerCarrito" text="🛒"
                    style="-fx-background-color: #F4F6FA; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 8 12; -fx-font-size: 14px;" />
        </HBox>

        <HBox alignment="CENTER" spacing="10">
            <TextField fx:id="busquedaField" promptText="Buscar por nombre o descripción..." HBox.hgrow="ALWAYS" style="-fx-background-radius: 8;
                        -fx-padding: 8; -fx-border-radius: 8; -fx-border-color: #cccccc; -fx-background-color: #f9f9f9;"/>
            <ComboBox fx:id="categoriaFilter" promptText="Filtrar por Categoría" style="-fx-background-radius: 8; -fx-padding: 8; -fx-border-radius: 8;
                        -fx-border-color: #cccccc; -fx-background-color: #f9f9f9;"/>
            <Button text="Buscar" onAction="#onSearchClick" style="-fx-background-color: #4A90E2; -fx-text-fill: white; -fx-font-weight: bold;
                        -fx-background-radius: 8; -fx-padding: 8 20; -fx-cursor: hand;"/>
        </HBox>

        <TableView fx:id="resultadosTable" prefHeight="400" prefWidth="800">
            <columns>
                <TableColumn fx:id="tipoColumn" text="Tipo"/>
                <TableColumn fx:id="nombreColumn" text="Nombre"/>
                <TableColumn fx:id="descripcionColumn" text="Descripción"/>
                <TableColumn fx:id="categoriaColumn" text="Categoría"/>
                <TableColumn fx:id="precioColumn" text="Precio"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

        <HBox alignment="CENTER_RIGHT" spacing="20">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Button text="Agregar al Carrito"
                    onAction="#onAgregarCarritoClick"
                    style="-fx-background-color: #50C878; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 20;"/>
            <Button text="Volver"
                    onAction="#onVolverClick"
                    style="-fx-background-color: #E94E77; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 20;"/>
        </HBox>
    </VBox>
</StackPane>
