<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<AnchorPane prefHeight="700.0" prefWidth="960.0"
            style="-fx-background-color: linear-gradient(to bottom right, #4A90E2, #50C9CE);"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controladores.CalificarController">

    <VBox alignment="TOP_CENTER" spacing="24"
          style="-fx-background-color: white; -fx-background-radius: 20; -fx-border-radius: 20;
                 -fx-padding: 32 48 40 48; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10,0,0,4);"
          AnchorPane.topAnchor="40" AnchorPane.bottomAnchor="40"
          AnchorPane.leftAnchor="80" AnchorPane.rightAnchor="80">

        <!-- CABECERA -->
        <HBox alignment="CENTER_LEFT" spacing="20">
            <VBox spacing="6">
                <Label style="-fx-font-size: 20px; -fx-font-weight: 700; -fx-text-fill: #2E3A59;"
                       text="Calificar un Curso o Servicio" />
                <Label style="-fx-font-size: 13px; -fx-text-fill: #7A8BA3;"
                       text="Selecciona un curso o servicio que hayas adquirido y deja tu opinión" />
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER_RIGHT" spacing="14">
                <Button fx:id="btnVolver"
                        text="Volver"
                        onAction="#onVolver"
                        style="-fx-background-color: #E63946; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 8 14;" />
            </HBox>
        </HBox>

        <Separator prefWidth="720" style="-fx-opacity: 0.3;" />

        <!-- CONTENIDO PRINCIPAL -->
        <VBox alignment="CENTER" spacing="20" prefHeight="400" prefWidth="800">

            <!-- SELECCIÓN DE TIPO Y ELEMENTO -->
            <HBox alignment="CENTER" spacing="10">
                <Label text="Tipo:" style="-fx-font-size: 13px; -fx-font-weight: bold;" />
                <ComboBox fx:id="comboTipo" prefWidth="160" promptText="Seleccionar tipo">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Servicios" />
                            <String fx:value="Cursos" />
                        </FXCollections>
                    </items>
                </ComboBox>

                <ComboBox fx:id="comboElemento" prefWidth="280" promptText="Selecciona un elemento" />
                <Button fx:id="btnCargar"
                        text="Cargar"
                        onAction="#onCargar"
                        style="-fx-background-color: #4A90E2; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" />
            </HBox>

            <Separator prefWidth="600" style="-fx-opacity: 0.2;" />

            <!-- FORMULARIO DE CALIFICACIÓN -->
            <VBox alignment="CENTER" spacing="14" prefWidth="600">

                <Label text="Tu calificación" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2E3A59;" />

                <HBox alignment="CENTER" spacing="6">
                    <Label text="Puntaje:" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
                    <Slider fx:id="sliderPuntaje" min="1" max="5" value="3" majorTickUnit="1"
                            minorTickCount="0" blockIncrement="1" snapToTicks="true" showTickMarks="true" showTickLabels="true"
                            style="-fx-control-inner-background: #C9D7F2;" prefWidth="200" />
                </HBox>

                <Label text="Comentario:" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
                <TextArea fx:id="txtComentario" prefHeight="120" prefWidth="500"
                          promptText="Escribe aquí tu opinión sobre el curso o servicio..."
                          style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #C9D7F2;" />

                <Button fx:id="btnEnviar"
                        text="Enviar Calificación"
                        onAction="#onEnviar"
                        style="-fx-background-color: #4A90E2; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 22; -fx-cursor: hand;" />
            </VBox>
        </VBox>

        <Region VBox.vgrow="ALWAYS" />

        <!-- PIE DE PÁGINA -->
        <HBox alignment="CENTER">
            <Label style="-fx-font-size: 12px; -fx-text-fill: #7A7A7A;"
                   text="© 2025 Emkauri — Todos los derechos reservados" />
        </HBox>

    </VBox>
</AnchorPane>
