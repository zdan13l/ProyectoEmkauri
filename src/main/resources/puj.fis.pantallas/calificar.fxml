<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<!-- ARCHIVO FXML PARA LA PANTALLA DE CALIFICACIÓN DE PRODUCTOS -->
<AnchorPane styleClass="fondo-celeste" xmlns:fx="http://javafx.com/fxml" fx:controller="controladores.CalificarController" stylesheets="@../css/interfaz.css">
    <VBox alignment="TOP_CENTER" spacing="24" styleClass="content-card"
            AnchorPane.topAnchor="40"
            AnchorPane.bottomAnchor="40"
            AnchorPane.leftAnchor="80"
            AnchorPane.rightAnchor="80">

        <HBox alignment="CENTER_LEFT" spacing="20">
            <VBox spacing="6">
                <Label text="Calificar un Producto" styleClass="title-label" />
                <Label text="Selecciona un curso o servicio que hayas adquirido y deja tu opinión" styleClass="subtitle-label" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnVolver" text="Volver" onAction="#onVolver" styleClass="btn-danger" />
        </HBox>
        <Separator prefWidth="720" styleClass="separator" />

        <VBox alignment="CENTER" spacing="20" prefHeight="400" prefWidth="800">
            <HBox alignment="CENTER" spacing="10">
                <Label text="Tipo:" styleClass="section-subtitle" />
                <ComboBox fx:id="comboTipo" prefWidth="160" promptText="Seleccionar tipo" styleClass="input-field">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Servicios" />
                            <String fx:value="Cursos" />
                        </FXCollections>
                    </items>
                </ComboBox>
                <ComboBox fx:id="comboElemento" prefWidth="280" promptText="Selecciona un elemento" styleClass="input-field" />
                <Button fx:id="btnCargar" text="Cargar" onAction="#onCargar" styleClass="primary-button" />
            </HBox>
            <Separator prefWidth="600" styleClass="separator" />
            <VBox alignment="CENTER" spacing="14" prefWidth="600">
                <Label text="Tu calificación" styleClass="section-title" />
                <HBox alignment="CENTER" spacing="6">
                    <Label text="Puntaje:" styleClass="card-text" />
                    <Slider fx:id="sliderPuntaje" min="1" max="5" value="3"
                            majorTickUnit="1" minorTickCount="0"
                            blockIncrement="1" snapToTicks="true"
                            showTickMarks="true" showTickLabels="true"
                            prefWidth="200" />
                </HBox>
                <Label text="Comentario:" styleClass="card-text" />
                <TextArea fx:id="txtComentario" prefHeight="120" prefWidth="500" promptText="Escribe aquí tu opinión..." styleClass="input-field" />
                <Button fx:id="btnEnviar" text="Enviar Calificación" onAction="#onEnviar" styleClass="primary-button" />
            </VBox>
        </VBox>
        <Region VBox.vgrow="ALWAYS" />
        <HBox alignment="CENTER"><Label text="© 2025 Emkauri — Todos los derechos reservados" styleClass="footer-text" /></HBox>
    </VBox>
</AnchorPane>
