<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- ARCHIVO FXML PARA LA PANTALLA DE ACCEDER A UN CURSO -->
<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="controladores.AccederCursoController" stylesheets="@../css/interfaz.css" styleClass="root-pane">
    <VBox alignment="TOP_CENTER" spacing="20" styleClass="content-card"
            AnchorPane.topAnchor="40"
            AnchorPane.bottomAnchor="40"
            AnchorPane.leftAnchor="40"
            AnchorPane.rightAnchor="40">

        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="section-header">
            <Label fx:id="lblTituloCurso" text="Curso" styleClass="title-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnVolver" text="Volver" onAction="#onVolver" styleClass="btn-secondary"/>
        </HBox>

        <VBox alignment="CENTER_LEFT" spacing="6">
            <Label text="Materiales del curso" styleClass="section-title"/>
            <Label text="Accede al contenido del curso y marca los materiales como completados." styleClass="subtitle-label"/>
        </VBox>

        <ScrollPane fitToWidth="true" prefHeight="330" hbarPolicy="NEVER" styleClass="scroll-card">
            <VBox fx:id="contenedorMateriales" spacing="10" style="-fx-background-color: transparent;"/>
        </ScrollPane>

        <VBox alignment="CENTER" spacing="10">
            <Label text="Progreso del curso" styleClass="section-title"/>
            <ProgressBar fx:id="barraProgreso" prefWidth="350" progress="0.0"/>
            <Label fx:id="lblProgreso" text="0% completado" styleClass="subtitle-label"/>
        </VBox>

        <HBox alignment="CENTER" spacing="12" styleClass="bottom-buttons">
            <Button fx:id="btnCertificado" text="Obtener Certificado" onAction="#onObtenerCertificado" disable="true" styleClass="green-button"/>
        </HBox>
        <HBox alignment="CENTER"> <Label text="© 2025 Emkauri — Todos los derechos reservados" styleClass="footer-text"/> </HBox>
    </VBox>
</AnchorPane>
