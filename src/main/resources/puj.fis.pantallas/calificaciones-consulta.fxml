<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="controladores.CalificacionController"
           style="-fx-background-color: linear-gradient(to bottom right, #4A90E2, #50C9CE);">

    <VBox alignment="CENTER" spacing="15.0" maxWidth="700"
          style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 30;">

        <effect>
            <DropShadow radius="10" color="#00000055"/>
        </effect>

        <Label text="Mis Calificaciones"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>

        <TableView fx:id="calificacionesTable" prefHeight="400" prefWidth="600">
            <columns>
                <TableColumn fx:id="cursoColumn" text="Curso"/>
                <TableColumn fx:id="notaColumn" text="Nota"/>
                <TableColumn fx:id="comentarioColumn" text="Comentario"/>
                <TableColumn fx:id="fechaColumn" text="Fecha"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

    </VBox>
</StackPane>
