<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="569.0" prefWidth="960.0" style="-fx-background-color: linear-gradient(to bottom right, #4A90E2, #50C9CE);" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controladores.SolicitudController">
    <VBox alignment="TOP_CENTER" layoutY="66.0" prefHeight="463.0" prefWidth="800.0" spacing="36" style="-fx-background-color: white; -fx-background-radius: 20; -fx-border-radius: 20; -fx-padding: 32 48 40 48; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10,0,0,4);"
            AnchorPane.bottomAnchor="40" AnchorPane.leftAnchor="80" AnchorPane.rightAnchor="80" AnchorPane.topAnchor="66.0">
        <HBox alignment="CENTER_LEFT" prefHeight="60" spacing="20">
            <Button fx:id="btnVolver" onAction="#onVolver" style="-fx-background-color: transparent; -fx-border-color: #4A90E2; -fx-border-width: 2; -fx-border-radius: 8; -fx-text-fill: #4A90E2; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 6 14; -fx-cursor: hand;" text="Volver" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnCerrarSesion" onAction="#onCerrarSesion" style="-fx-background-color: #E63946; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 8 14; -fx-cursor: hand;" text="Cerrar sesión" />
        </HBox>
        <Separator prefHeight="22.0" prefWidth="704.0" style="-fx-opacity: 0.3;" />
        <VBox alignment="CENTER" spacing="8">
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2E3A59;" text="Solicitudes de Producto" />
            <Label style="-fx-font-size: 13px; -fx-text-fill: #7A8BA3;" text="Gestiona las solicitudes pendientes de productos." />
        </VBox>
        <ScrollPane fitToWidth="true" prefHeight="420" prefWidth="820" style="-fx-background-color: transparent; -fx-border-color: transparent;">
            <VBox fx:id="contenedorSolicitudes" alignment="TOP_CENTER" spacing="16" style="-fx-padding: 10;">
                <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-background-color: #F8FAFF; -fx-background-radius: 12; -fx-padding: 16 20; -fx-border-color: #C9D7F2; -fx-border-radius: 12;">
                    <VBox spacing="6">
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #2E3A59;" text="Nombre del Producto" />
                        <Label style="-fx-text-fill: #5A6B88; -fx-font-size: 12px;" text="Categoría del producto" />
                        <Label style="-fx-text-fill: #2E3A59; -fx-font-size: 13px;" text="Descripción o mensaje de la solicitud" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <HBox spacing="8">
                        <Button fx:id="btnAprobar" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 6 14; -fx-cursor: hand;" text="Aprobar" />
                        <Button fx:id="btnRechazar" style="-fx-background-color: #E63946; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 6 14; -fx-cursor: hand;" text="Rechazar" />
                    </HBox>
                </HBox>
            </VBox>
        </ScrollPane>
        <HBox alignment="CENTER">
            <Label style="-fx-font-size: 12px; -fx-text-fill: #7A7A7A;" text="© 2025 Emkauri — Todos los derechos reservados" />
        </HBox>
    </VBox>
</AnchorPane>
