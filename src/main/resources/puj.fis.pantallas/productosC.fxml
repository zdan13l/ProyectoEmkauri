<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="569" prefWidth="960" style="-fx-background-color: linear-gradient(to bottom right, #4A90E2, #50C9CE); -fx-font-family: 'Segoe UI';" xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="controladores.ProductoCController">

    <VBox alignment="TOP_CENTER" spacing="18" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 22 26 20 26; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10,0,0,4);"
            AnchorPane.bottomAnchor="40" AnchorPane.leftAnchor="40" AnchorPane.rightAnchor="40" AnchorPane.topAnchor="40">

        <HBox alignment="CENTER_LEFT" prefHeight="56" spacing="10" style="-fx-padding: 6 4 6 4;">
            <Label style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #2E3A59;" text="📦 Mis Productos" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnVolverHeader" onAction="#onVolverHeader" style="-fx-background-color: transparent; -fx-border-color: #4A90E2; -fx-border-width: 2; -fx-border-radius: 8;
                -fx-text-fill: #4A90E2; -fx-font-weight: bold; -fx-padding: 6 12;" text="Volver" />
        </HBox>

        <Separator style="-fx-opacity: 0.12;" />

        <VBox alignment="CENTER_LEFT" spacing="6" style="-fx-padding: 4 0 4 0;">
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2E3A59;" text="Tus cursos y servicios adquiridos" />
            <Label style="-fx-font-size: 13px; -fx-text-fill: #7A8BA3;" text="Consulta los cursos o servicios que has comprado. Selecciona uno y pulsa 'Ver Detalle' o'Calificaciones'." />
        </VBox>

        <TableView fx:id="tablaProductosCliente" prefHeight="360" prefWidth="820" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e6eef9; -fx-border-width: 1;">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colCategoria" prefWidth="100" text="Categoría" />
                <TableColumn fx:id="colNombre" prefWidth="200" text="Nombre" />
                <TableColumn fx:id="colDescripcion" prefWidth="250" text="Descripción" />
                <TableColumn fx:id="colEmprendedor" prefWidth="180" text="Emprendedor" />
            </columns>
        </TableView>

        <HBox alignment="CENTER_LEFT" prefHeight="60" spacing="12" style="-fx-padding: 8 0 0 0;">
            <Button fx:id="btnVerDetalle" onAction="#onVerDetalle" style="-fx-background-color: #27AE60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 18;" text="Ver Detalle" />
            <Button fx:id="btnCalificaciones" onAction="#onCalificaciones" style="-fx-background-color: #F39C12; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 18;" text="Calificaciones" />
            <Region HBox.hgrow="ALWAYS" />
        </HBox>

        <HBox alignment="CENTER" style="-fx-padding: 6 0 0 0;">
            <Label style="-fx-font-size: 12px; -fx-text-fill: #7A7A7A;" text="© 2025 Emkauri — Todos los derechos reservados" />
        </HBox>
    </VBox>
</AnchorPane>
