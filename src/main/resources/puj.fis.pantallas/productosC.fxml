<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- ARCHIVO FXML PARA LA PANTALLA DE PRODUCTOS ADQUIRIDOS POR EL CLIENTE -->
<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="controladores.ProductoCController" stylesheets="@../css/interfaz.css" styleClass="root-pane">
    <VBox alignment="TOP_CENTER" spacing="20" styleClass="content-card"
            AnchorPane.topAnchor="40"
            AnchorPane.bottomAnchor="40"
            AnchorPane.leftAnchor="40"
            AnchorPane.rightAnchor="40">

        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="section-header">
            <Label text="📦 Mis Productos" styleClass="title-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnVolver" text="Volver" onAction="#onVolver" styleClass="btn-secondary"/>
        </HBox>

        <VBox alignment="CENTER_LEFT" spacing="6">
            <Label text="Tus productos adquiridos" styleClass="section-title"/>
            <Label text="Consulta los cursos o servicios que has comprado. Selecciona uno y pulsa 'Ver Detalle' o 'Calificar Producto'." styleClass="subtitle-label"/>
        </VBox>

        <TableView fx:id="tablaProductosCliente" prefHeight="360" styleClass="styled-table">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>

            <columns>
                <TableColumn fx:id="colCategoria" text="Categoría"/>
                <TableColumn fx:id="colNombre" text="Nombre"/>
                <TableColumn fx:id="colDescripcion" text="Descripción"/>
                <TableColumn fx:id="colEmprendedor" text="Emprendedor"/>
            </columns>
        </TableView>

        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="bottom-buttons">
            <Button fx:id="btnVerDetalle" text="Ver Detalle" onAction="#onVerDetalle" styleClass="green-button"/>
            <Button fx:id="btnCalificaciones" text="Calificar Producto" onAction="#onCalificaciones" styleClass="yellow-button"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <HBox alignment="CENTER"> <Label text="© 2025 Emkauri — Todos los derechos reservados" styleClass="footer-text"/> </HBox>
    </VBox>
</AnchorPane>
