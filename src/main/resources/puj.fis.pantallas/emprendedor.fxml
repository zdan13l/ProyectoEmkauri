<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<!-- ARCHIVO FXML PARA LA PANTALLA DEL EMPRENDEDOR -->
<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="controladores.EmprendedorController" styleClass="root-pane" stylesheets="@../css/interfaz.css">
    <children>
        <VBox alignment="TOP_CENTER" spacing="36"
                styleClass="content-card"
                AnchorPane.topAnchor="40"
                AnchorPane.bottomAnchor="40"
                AnchorPane.leftAnchor="80"
                AnchorPane.rightAnchor="80">

            <HBox alignment="CENTER_LEFT" spacing="20">
                <VBox spacing="6">
                    <Label fx:id="lblBienvenidaTop" text="¡Bienvenid@, Emprendedor!" styleClass="title"/>
                    <Label text="Gestiona y crea tus productos, cursos o servicios desde aquí" styleClass="subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>

                <HBox spacing="14" alignment="CENTER_RIGHT">
                    <Button fx:id="btnMisProductos" text="Mis Productos" onAction="#onVerMisProductos" styleClass="nav-button"/>
                    <Button fx:id="btnCalificaciones" text="Calificaciones" onAction="#onVerCalificaciones" styleClass="nav-button"/>
                    <Button fx:id="btnCerrarSesion" text="Cerrar sesión" onAction="#onCerrarSesion" styleClass="logout-button"/>
                </HBox>
            </HBox>

            <Separator styleClass="separator" prefWidth="720"/>

            <VBox spacing="24" alignment="CENTER">
                <ImageView fx:id="welcomeIllustration" fitHeight="180" preserveRatio="true">
                    <image> <Image url="@../img/Emkauri_logo.png"/> </image>
                </ImageView>

                <Label text="Administra y crea tus cursos o servicios" styleClass="section-title"/>
                <Label text="Selecciona una acción a continuación para continuar" styleClass="section-subtitle"/>

                <HBox alignment="CENTER" spacing="20">
                    <Button fx:id="btnIrCrearCurso" text="Crear Curso" onAction="#onCrearCurso" styleClass="primary-button"/>
                    <Button fx:id="btnIrCrearServicio" text="Crear Servicio" onAction="#onCrearServicio" styleClass="secondary-button"/>
                </HBox>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>

            <HBox alignment="CENTER"> <Label text="© 2025 Emkauri — Todos los derechos reservados" styleClass="footer-text"/></HBox>
        </VBox>
    </children>
</AnchorPane>
