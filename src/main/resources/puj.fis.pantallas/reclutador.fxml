<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<!-- ARCHIVO FXML PARA LA PANTALLA DEL RECLUTADOR -->
<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="controladores.ReclutadorController" stylesheets="@../css/interfaz.css" styleClass="root-pane">
    <VBox alignment="TOP_CENTER" spacing="36" styleClass="content-card"
            AnchorPane.bottomAnchor="40"
            AnchorPane.leftAnchor="80"
            AnchorPane.rightAnchor="80"
            AnchorPane.topAnchor="40">

        <HBox alignment="CENTER_LEFT" prefHeight="100" spacing="20">
            <VBox spacing="6">
                <Label fx:id="lblBienvenidaTop" styleClass="title" text="¡Bienvenid@, Reclutador!" />
                <Label styleClass="subtitle" text="Administra las solicitudes de productos y emprendedores" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox spacing="14">
                <Button fx:id="btnSolicitudesProducto" onAction="#onSolicitudesProducto" styleClass="nav-button" text="Producto" />
                <Button fx:id="btnSolicitudesEmprendedor" onAction="#onSolicitudesEmprendedor" styleClass="nav-button" text="Emprendedor" />
                <Button fx:id="btnCerrarSesion" onAction="#onCerrarSesion" styleClass="logout-button" text="Cerrar sesión" />
            </HBox>
        </HBox>

        <Separator prefWidth="720" styleClass="separator" />
        <VBox alignment="CENTER" spacing="24">
            <ImageView fx:id="logoEmkauri" fitHeight="180" fitWidth="236" preserveRatio="true" smooth="true">
                <image> <Image url="@../img/Emkauri_logo.png" /> </image>
            </ImageView>

            <Label styleClass="section-title" text="Revisa y gestiona las solicitudes pendientes" />
            <Label styleClass="section-subtitle" text="Selecciona el tipo de solicitud que deseas analizar" />

            <HBox alignment="CENTER" spacing="20">
                <Button fx:id="btnIrSolicitudesProducto" onAction="#onSolicitudesProducto" styleClass="primary-button" text="Solicitudes de Producto" />
                <Button fx:id="btnCategorias" onAction="#onCategorias" styleClass="secondary-button" text="Gestionar Categorías" />
                <Button fx:id="btnIrSolicitudesEmprendedor" onAction="#onSolicitudesEmprendedor" styleClass="primary-button" text="Solicitudes de Emprendedor" />
            </HBox>
        </VBox>

        <Region VBox.vgrow="ALWAYS" />
        <HBox alignment="CENTER"> <Label styleClass="footer-text" text="© 2025 Emkauri — Todos los derechos reservados" /></HBox>
    </VBox>
</AnchorPane>
