<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- PANTALLA DE SOLICITUD DE PRODUCTOS -->
<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="controladores.SolicitudProductoController" stylesheets="@../css/interfaz.css" styleClass="fondo-celeste">
    <VBox alignment="TOP_CENTER" spacing="20" styleClass="content-card"
            AnchorPane.topAnchor="0"
            AnchorPane.bottomAnchor="0"
            AnchorPane.leftAnchor="0"
            AnchorPane.rightAnchor="0">

        <HBox alignment="CENTER" spacing="12" prefHeight="33" prefWidth="40">
            <Button fx:id="btnVolver" onAction="#onVolver" text="Volver" styleClass="btn-danger" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="Solicitud de Nuevo Producto" styleClass="title-label" prefHeight="32" prefWidth="367" />
            <Region HBox.hgrow="ALWAYS" />
        </HBox>

        <Separator styleClass="separator" prefWidth="800" />
        <ScrollPane fx:id="scrollForm" fitToWidth="true" pannable="true" style="-fx-background-color: transparent; -fx-border-color: transparent;">
            <VBox.vgrow> <Priority fx:constant="ALWAYS"/> </VBox.vgrow>
            <content>
                <VBox alignment="TOP_CENTER" spacing="20">
                    <padding> <Insets top="20" right="20" bottom="20" left="20"/> </padding>
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="Tipo de producto:" styleClass="section-title"/>
                        <RadioButton fx:id="rbCurso" disable="true" text="Curso">
                            <toggleGroup>
                                <ToggleGroup fx:id="tipoProductoGroup"/>
                            </toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="rbServicio" disable="true" text="Servicio" toggleGroup="$tipoProductoGroup"/>
                    </HBox>

                    <VBox alignment="CENTER_LEFT" spacing="6">
                        <Label text="Título:" styleClass="section-title"/>
                        <TextField fx:id="txtTitulo" promptText="Escribe un título descriptivo..." styleClass="input-field"/>
                    </VBox>

                    <VBox alignment="CENTER_LEFT" spacing="6">
                        <Label text="Descripción:" styleClass="section-title"/>
                        <TextArea fx:id="txtDescripcion" promptText="Describe el curso o servicio..." prefRowCount="4" wrapText="true" styleClass="input-field"/>
                    </VBox>

                    <VBox alignment="CENTER_LEFT" spacing="6">
                        <Label text="Precio:" styleClass="section-title"/>
                        <TextField fx:id="txtPrecio" promptText="Ej: 49.99" styleClass="input-field"/>
                    </VBox>

                    <VBox alignment="CENTER_LEFT" spacing="6">
                        <Label text="Categoría:" styleClass="section-title"/>
                        <ComboBox fx:id="cmbCategoria" prefWidth="250" promptText="Selecciona una categoría" styleClass="input-field"/>
                    </VBox>

                    <VBox fx:id="boxCurso" alignment="CENTER_LEFT" spacing="10" visible="false" managed="false">
                        <Label text="Duración (horas):" styleClass="section-title"/>
                        <TextField fx:id="txtDuracionCurso" promptText="Ej: 20" styleClass="input-field"/>
                        <Label text="Nivel de dificultad:" styleClass="section-title"/>
                        <TextField fx:id="txtNivelDificultad" promptText="Ej: Principiante" styleClass="input-field"/>
                        <Label text="Certificación:" styleClass="section-title"/>
                        <TextField fx:id="txtCertificacion" promptText="Ej: Certificado de finalización" styleClass="input-field"/>
                    </VBox>

                    <VBox fx:id="boxServicio" alignment="CENTER_LEFT" spacing="10" visible="false" managed="false">
                        <Label text="Duración (minutos):" styleClass="section-title"/>
                        <TextField fx:id="txtDuracionServicio" promptText="Ej: 60" styleClass="input-field"/>
                        <Label text="Ubicación:" styleClass="section-title"/>
                        <TextField fx:id="txtUbicacion" promptText="Ej: Medellín o En línea" styleClass="input-field"/>
                        <Label text="Modalidad:" styleClass="section-title"/>
                        <TextField fx:id="txtModalidad" promptText="Ej: Presencial / Virtual" styleClass="input-field"/>
                    </VBox>

                    <HBox alignment="CENTER" spacing="10">
                        <Button fx:id="btnEnviarSolicitud" onAction="#onEnviarSolicitud" text="Enviar Solicitud" styleClass="primary-button"/>
                    </HBox>
                    <Label fx:id="lblConfirmacion" styleClass="card-text"/>
                </VBox>
            </content>
        </ScrollPane>
    </VBox>
</AnchorPane>
